# ══════════════════════════ LLM (Cloudflare) ══════════════════════════
# Un seul token Cloudflare = accès à plusieurs modèles.
# Option A — Workers AI :
#   1. Créez un token sur https://dash.cloudflare.com/profile/api-tokens
#      (permission "Workers AI Read" suffit).
#   2. Renseignez CLOUDFLARE_ACCOUNT_ID (page d'accueil du dashboard).
#   Le point de terminaison OpenAI-compatible est construit automatiquement :
#   https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1
CLOUDFLARE_ACCOUNT_ID=
LLM_API_KEY=

# Modèle par défaut (function calling fiable sur Workers AI).
# Autres exemples : @cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_MODEL=@cf/openai/gpt-oss-120b

# Option B — Cloudflare AI Gateway (proxy multi-fournisseurs) :
#   LLM_BASE_URL=https://gateway.ai.cloudflare.com/v1/{COMPTE}/{GATEWAY}/openai
#   puis LLM_MODEL=gpt-4o-mini, google-ai-studio/gemini-..., etc.
#LLM_BASE_URL=

# ══════════════════════════ Ever Gauzy ══════════════════════════
# mock : données simulées du restaurant Périssos (aucune connexion requise)
# live : instance réelle Ever Gauzy (URL + token obligatoires)
EVERGAUZY_MODE=mock
EVERGAUZY_BASE_URL=
EVERGAUZY_API_TOKEN=

# Chemins d'API à ajuster selon votre version d'Ever Gauzy une fois l'accès fourni
EVERGAUZY_RESERVATIONS_PATH=/api/reservations
EVERGAUZY_TABLES_PATH=/api/tables
EVERGAUZY_INVOICES_PATH=/api/invoices
EVERGAUZY_PRODUCTS_PATH=/api/products

# ══════════ Périmètre single-tenant (injecté dans CHAQUE requête API) ══════════
ORGANIZATION_ID=org-perissos
TENANT_ID=tenant-perissos

# ══════════════════════════ Base de données (PostgreSQL) ══════════════════════════
# Dev local (docker-compose) — en production : URL de votre base (ex. Neon)
DATABASE_URL=postgres://perissos:dev_password@localhost:5433/perissos_restaurant

# ══════════════════════════ Sessions portail (auth employés) ══════════════════════════
# Secret de signature des cookies de session — OBLIGATOIRE à changer en production.
SESSION_SECRET=

# ══════════════════════════ Accès démo (présentation) ══════════════════════════
# 1 = active les routes /api/auth/demo (liste + connexion par profil, boutons sur
# l'écran de connexion). VIDE ou absent en production : les routes n'existent pas (404).
DEMO_PRESENTATION=1

# ══════════════════════════ Identité du restaurant ══════════════════════════
RESTAURANT_NAME=Périssos
RESTAURANT_VILLE=Abidjan

# ══════════════════ WhatsApp Business Cloud API (Meta) ══════════════════
# 1. Créez une application sur https://developers.facebook.com → WhatsApp
# 2. WHATSAPP_TOKEN : jeton d'accès (Configuration de l'API → jeton permanent ou temporaire)
# 3. WHATSAPP_PHONE_NUMBER_ID : visible dans Configuration de l'API
# 4. Webhook : exposez ce serveur en HTTPS (ex. « cloudflared tunnel --url http://localhost:3000 »)
#    puis collez l'URL dans Meta for Developers → WhatsApp → Configuration → Webhook,
#    avec le jeton de vérification ci-dessous.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=perissos-chafik

# Secret d'application (Paramètres → Basique) : active la vérification de signature X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Port d'écoute du webhook
WHATSAPP_PORT=3000

# Port de l'interface web (tableau de bord + chatbot du site)
# 3000 et 3001 sont souvent pris par Ever Gauzy / Docker — 4040 par défaut ici.
WEB_PORT=4040

# Numéros WhatsApp du patron : Chafik leur répond avec les rapports financiers (rôle patron).
# Séparés par des virgules. Exemple : WHATSAPP_ADMIN_PHONES=+225 07 00 00 00 01,+225 05 00 00 00 02
WHATSAPP_ADMIN_PHONES=

# ══════════════════════════ Monitoring (Sentry) ══════════════════════════
# DSN Sentry — laisser vide en dev (monitoring désactivé)
SENTRY_DSN=
